# CSlate Local Dev Environment
# Copy this file to .env.development and fill in your values

# Server (local Docker)
CSLATE_SERVER_URL=http://localhost:3000

# Path to CSlate-server repo (used by docker-compose.dev.yml)
# Default ../CSlate-server works when running from the main CSlate repo root.
# If running from a git worktree, set this to the absolute path or correct relative path.
# Example for worktree at .worktrees/plan-01-scaffolding:
# CSLATE_SERVER_PATH=../../../CSlate-server
CSLATE_SERVER_PATH=../CSlate-server

# PostgreSQL (local Docker — matches docker-compose.dev.yml)
POSTGRES_URL=postgresql://cslate:cslate@localhost:5432/cslate_dev

# LLM — Anthropic API (required for agent functionality)
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Electron debug
ELECTRON_IS_DEV=true
ELECTRON_INSPECT_PORT=9229
